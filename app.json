{
  "expo": {
    "name": "Truth or Dare",
    "slug": "truthordare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./references/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "image": "./references/icon.png",
